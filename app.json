{
  "expo": {
    "name": "Mayg & Jaown",
    "slug": "total-lift",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "totallift",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.jdicesar.totallift",
      "supportsTablet": true,
      "appleTeamId": "7V9S64W92Z",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Mayg & Jaown reads your weight, sleep, HRV and resting heart rate to keep your cut from costing muscle. Nothing is written to Health.",
        "NSHealthUpdateUsageDescription": "Mayg & Jaown never writes to Apple Health. Apple requires this text because the app uses HealthKit."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#121212",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
